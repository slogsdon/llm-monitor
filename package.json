{
  "name": "llm-monitor",
  "version": "0.1.0",
  "description": "Live dashboard and snapshot reports for local LLM servers: LiteLLM, llama-swap, oMLX/mlx_lm, Ollama",
  "keywords": [
    "llm",
    "local-llm",
    "litellm",
    "llama-swap",
    "mlx",
    "omlx",
    "ollama",
    "llama-cpp",
    "apple-silicon",
    "macos",
    "monitoring",
    "dashboard",
    "tui",
    "cli",
    "ink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slogsdon/llm-monitor.git"
  },
  "homepage": "https://github.com/slogsdon/llm-monitor#readme",
  "bugs": {
    "url": "https://github.com/slogsdon/llm-monitor/issues"
  },
  "author": "Shane Logsdon",
  "type": "module",
  "bin": {
    "llm-monitor": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "js-yaml": "^5.4.2",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
